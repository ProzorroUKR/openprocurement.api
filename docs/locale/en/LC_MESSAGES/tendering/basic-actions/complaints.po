msgid "Схема роботи скарг/вимог"
msgstr "Claims/Complaints Workflow"

msgid "Вимоги"
msgstr "Claims"

msgid "Туторіали"
msgstr "Tutorials"

msgid "Вимоги на умови закупівлі"
msgstr "Tender Conditions Claims"

msgid "Вимоги на кваліфікацію"
msgstr "Tender Qualification Claims"

msgid "Вимоги на пре-кваліфікацію"
msgstr "Tender Pre-qualification Claims"

msgid "Статуси"
msgstr "Statuses"

msgid "draft"
msgstr ""

msgid "Початковий статус"
msgstr "Initial status"

msgid "На цьому етапі скаржник може подати вимогу, завантажити документи, відкликати вимогу та подати її знову."
msgstr "Complainant can submit claim, upload documents, cancel claim, and re-submit it."

msgid "claim"
msgstr ""

msgid "Замовник може завантажити документи та відповісти на вимогу."
msgstr "Procuring entity can upload documents and answer to claim."

msgid "Скаржник може відкликати вимогу."
msgstr "Complainant can cancel claim."

msgid "answered"
msgstr ""

msgid "Скаржник може відкликати вимогу, завантажити документи, згодитись або не згодитись з вирішенням."
msgstr "Complainant can cancel claim, upload documents, agree or disagree with decision."

msgid "resolved"
msgstr ""

msgid "Кінцевий статус"
msgstr "Terminal status"

msgid "Вимогу визнано вирішеною."
msgstr "Claim recognized as resolved."

msgid "cancelled"
msgstr ""

msgid "Вимогу відкликано скаржником."
msgstr "Claim cancelled by complainant."

msgid "Скарги"
msgstr "Complaints"

msgid "До релізу 2020-04-19"
msgstr "Before Release 2020-04-19"

msgid "Скарги на умови закупівлі"
msgstr "Tender Conditions Complaints"

msgid "Скарги на кваліфікацію"
msgstr "Tender Qualification Complaints"

msgid "Скарги на пре-кваліфікацію"
msgstr "Tender Pre-qualification Complaints"

msgid "Скаржник може завантажити документи та подати скаргу."
msgstr "Complainant can upload documents and submit complaint."

msgid "pending"
msgstr ""

msgid "Орган оскарження може завантажувати документи та розглядати скарги."
msgstr "Reviewer can upload documents and review complaint."

msgid "accepted"
msgstr ""

msgid "Скарга прийнята до розгляду"
msgstr "Complaint accepted"

msgid "satisfied"
msgstr ""

msgid "Скарга задоволена АМКУ"
msgstr "Complaint is the satisfied by reviewer"

msgid "stopping"
msgstr ""

msgid "Скарга відкликана участником"
msgstr "Complaint recalled by participant"

msgid "stopped"
msgstr ""

msgid "Розгляд по скарзі припинено"
msgstr "Сomplaint has been discontinued"

msgid "mistaken"
msgstr ""

msgid "Скарга була помилково направлена("
msgstr "Complaint was in error"

msgid "invalid"
msgstr ""

msgid "Вимогу визнано недійсною."
msgstr "Claim recognized as invalid."

msgid "declined"
msgstr ""

msgid "Вимогу визнано відхиленою."
msgstr "Claim recognized as declined."

msgid "Скаргу визнано вирішеною."
msgstr "Complaint recognized as resolved."

msgid "Після релізу 2020-04-19"
msgstr "After Release 2020-04-19"

msgid "Скарги на скасування закупівлі"
msgstr "Tender Cancellation Complaints"

msgid "Скаржник може завантажити документи, відхилити або подати скаргу."
msgstr "Complainant can upload documents, cancel complaint and submit complaint."

msgid "Якщо на закупівлю або відповідний лот створюється об'єкт скасування (cancellation), скарга автоматично переводиться у статус ``mistaken`` з причиною ``tenderOrLotCancelledBeforePayment``."
msgstr "If a cancellation object is created for the tender or the related lot, the complaint is automatically moved to ``mistaken`` status with the reason ``tenderOrLotCancelledBeforePayment``."

msgid "Скарга скасована."
msgstr "Complaint dismissed."

msgid "Можливі значення ``rejectReason``:"
msgstr "Possible ``rejectReason`` values:"

msgid "``complaintPeriodEnded`` — скаргу не було подано в межах строку оскарження"
msgstr "``complaintPeriodEnded`` — complaint was not submitted within the complaint period"

msgid "``tenderOrLotCancelledBeforePayment`` — закупівлю або лот було скасовано до зарахування оплати; кошти повертаються скаржнику"
msgstr "``tenderOrLotCancelledBeforePayment`` — the tender or lot was cancelled before payment was received; funds are returned to the complainant"

msgid "Ролі"
msgstr "Roles"

msgid "Complaint owner"
msgstr ""

msgid "пунктирна лінія"
msgstr "dashed"

msgid "Tender owner"
msgstr ""

msgid "звичайна лінія"
msgstr "plain"

msgid "AboveThresholdReviewer"
msgstr ""

msgid "жирна лінія"
msgstr "bold"

msgid "Chronograph"
msgstr ""

msgid "лінія з крапками"
msgstr "dotted"

