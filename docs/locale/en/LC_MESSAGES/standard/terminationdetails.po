msgstr ""

msgid "рядок, обов’язковий, генерується автоматично, лише для читання"
msgstr ""

msgid "Можливі значення:"
msgstr ""

msgid "`draft` - дані про завершення договору заповнюються замовником, ще не підписані."
msgstr ""

msgid "`active` - дані підписані замовником та зафіксовані остаточно."
msgstr ""

msgid "reasonType"
msgstr ""

msgid "рядок, обов’язковий для активації"
msgstr ""

