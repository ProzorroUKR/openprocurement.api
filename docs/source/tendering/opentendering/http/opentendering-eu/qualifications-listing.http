        ],
        "requirementGroups": [
          {
            "description": "Підтверджується, що:",
            "description_en": "It is confirmed that:",
            "requirements": [
              {
                "title": "Відсутній конфлікт інтересів у розумінні частини п’ятої статті 14 цього Закону який неможливо врегулювати",
                "title_en": "There is no conflict of interest within the meaning of Part 5 of Article 14 of this Law that cannot be resolved by other measures",
