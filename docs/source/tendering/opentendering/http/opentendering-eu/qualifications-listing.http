      {
        "title": "Отримання конкурентної переваги або порушення принципу недискримінації та рівного ставлення",
        "title_en": "Competitive advantage obtained or breach of the principles of non-discrimination and equal treatment",
        "description": "Cуб’єкт господарювання отримав від замовника під час проведення попередніх ринкових консультацій інформацію, що може надати йому конкурентну перевагу перед іншими учасниками, кандидатами, або попереднє залучення суб’єкта господарювання до підготовки процедури закупівлі призвело до порушення принципу недискримінації та рівного ставлення до суб’єктів господарювання. Відмова в участі в закупівлі з цієї підстави застосовується лише за умови, що дотримання зазначених принципів неможливо забезпечити в інший спосіб.",
        "description_en": "During the conduct of preliminary market consultations, the economic operator obtained information from the procuring entity that may confer a competitive advantage over other bidders or candidates, or the prior involvement of the economic operator in the preparation of the procurement procedure resulted in a breach of the principles of non-discrimination and equal treatment of economic operators. Refusal of participation in procurement on this ground shall apply only where compliance with those principles cannot be ensured by other means.",
        "source": "tenderer",
        "relatesTo": "tender",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.CONFLICT_OF_INTEREST.PROCEDURE_PREPARATION"
        },
        "id": "89716d842b9f4cb2a70d8b8725820f13",
        "legislation": [
          {
            "version": "2026-05-27",
            "identifier": {
              "id": "4888-IX",
              "legalName": "Закон України \"Про публічні закупівлі\"",
              "legalName_en": "Law of Ukraine \"On Public Procurement\"",
              "uri": "https://zakon.rada.gov.ua/laws/show/4888-20#n700"
            },
            "type": "NATIONAL_LEGISLATION",
            "article": "Пункт 14 частини 1 статті 21",
            "article_en": "Clause 14 of part 1 of article 21"
          }
        ],
        "requirementGroups": [
          {
            "description": "Підтверджується, що:",
            "description_en": "It is confirmed that:",
            "requirements": [
              {
                "title": "Cуб’єкт господарювання не отримував від замовника під час проведення попередніх ринкових консультацій інформацію, що може надати йому конкурентну перевагу перед іншими учасниками, кандидатами, або попереднє залучення суб’єкта господарювання до підготовки процедури закупівлі призвело до порушення принципу недискримінації та рівного ставлення до суб’єктів господарювання",
                "title_en": "During the conduct of preliminary market consultations, the economic operator has not obtained information from the procuring entity that may confer a competitive advantage over other bidders or candidates, or the prior involvement of the economic operator in the preparation of the procurement procedure resulted in a breach of the principles of non-discrimination and equal treatment of economic operators",
                "dataType": "boolean",
                "status": "active",
                "expectedValue": true,
                "id": "d92babdc22c742a3a957f44e86461b0b",
                "datePublished": "2027-01-01T00:00:00+02:00"
              }
            ],
            "id": "73528f437f8244cdb4ce58aaab28665b"
          }
        ]
      },
      {
        "title": "Конфлікт інтересів без можливості врегулювання",
        "title_en": "Conflict of interest that cannot be resolved",
        "description": "Конфлікт інтересів у розумінні частини п’ятої статті 14 цього Закону неможливо врегулювати за допомогою інших заходів.",
        "description_en": "The conflict of interest within the meaning of Part 5 of Article 14 of this Law cannot be resolved by other measures.",
        "source": "tenderer",
        "relatesTo": "tender",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.CONFLICT_OF_INTEREST.PROCEDURE_PARTICIPATION"
        },
        "id": "e51dc95048ba4ff3a50e067da25e1162",
        "legislation": [
          {
            "version": "2026-05-27",
            "identifier": {
              "id": "4888-IX",
              "legalName": "Закон України \"Про публічні закупівлі\"",
              "legalName_en": "Law of Ukraine \"On Public Procurement\"",
              "uri": "https://zakon.rada.gov.ua/laws/show/4888-20#n700"
