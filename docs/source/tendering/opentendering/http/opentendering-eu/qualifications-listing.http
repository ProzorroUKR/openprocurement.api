        "requirementGroups": [
          {
            "description": "Підтверджується, що:",
            "description_en": "It is confirmed that:",
            "requirements": [
              {
                "title": "Відомості про суб’єкта господарювання не внесено до Єдиного державного реєстру осіб, які вчинили корупційні або пов’язані з корупцією правопорушення",
                "title_en": "Information concerning the economic operator has not been entered into the Unified State Register of Persons Who Have Committed Corruption or Corruption-Related Offences",
                "dataType": "boolean",
                "status": "active",
                "expectedValue": true,
                "id": "718d6459c0f7446c944a43d7ea710485",
                "datePublished": "2027-01-01T00:00:00+02:00"
              },
              {
                "title": "Керівника суб’єкта господарювання або суб’єкта господарювання не було притягнуто до відповідальності згідно із законом за вчинення корупційного правопорушення або правопорушення, пов’язаного з корупцією",
                "title_en": "The head of the economic operator and the economic operator have not been held liable in accordance with the law for committing a corruption offence or a corruption-related offence",
