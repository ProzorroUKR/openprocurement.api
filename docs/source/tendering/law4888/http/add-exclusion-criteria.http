    {
      "title": "Вчинення правопорушень, повʼязаних із застосуванням санкцій",
      "title_en": "Offences related to the application of sanctions",
      "description": "Суб’єкт господарювання або кінцевий бенефіціарний власник, член або учасник (акціонер) суб’єкта господарювання є особою, до якої застосовано санкцію у виді заборони на здійснення у неї закупівель товарів, робіт і послуг згідно із Законом України \"Про санкції\", крім випадку, якщо активи такої особи у встановленому законодавством порядку передані в управління Національному агентству України з питань виявлення, розшуку та управління активами, одержаними від корупційних та інших злочинів.",
      "description_en": "The economic operator, or its ultimate beneficial owner, member or participant (shareholder), is a person in respect of whom the sanction prohibiting the procurement of goods, works and services from that person has been imposed pursuant to the Law of Ukraine \"On Sanctions\", except where the assets of such person have been transferred for management to the National Agency of Ukraine for Finding, Tracing and Management of Assets Derived from Corruption and Other Crimes in accordance with the procedure established by law.",
      "source": "tenderer",
      "classification": {
        "scheme": "LAW4888",
        "id": "CRITERION.EXCLUSION.CONVICTIONS.TERRORIST_OFFENCES"
      },
      "relatesTo": "tender",
      "legislation": [
        {
          "version": "2026-05-27",
          "identifier": {
            "id": "4888-IX",
            "legalName": "Закон України \"Про публічні закупівлі\"",
            "legalName_en": "Law of Ukraine \"On Public Procurement\"",
            "uri": "https://zakon.rada.gov.ua/laws/show/4888-20#n695"
          },
          "type": "NATIONAL_LEGISLATION",
          "article": "Пункт 11 частини 1 статті 21",
          "article_en": "Clause 11 of part 1 of article 21"
        },
        {
          "version": "2025-08-01",
          "identifier": {
            "id": "1644-VII",
            "legalName": "Закон України \"Про санкції\"",
            "legalName_en": "Law of Ukraine \"On Sanctions\"",
            "uri": "https://zakon.rada.gov.ua/laws/show/1644-18"
          },
          "type": "NATIONAL_LEGISLATION"
        }
      ],
      "requirementGroups": [
        {
          "description": "Підтверджується, що:",
          "description_en": "It is confirmed that:",
          "requirements": [
            {
              "title": "Суб’єкт господарювання або кінцевий бенефіціарний власник, член або учасник (акціонер) суб’єкта господарювання не є особою, до якої застосовано санкцію у виді заборони на здійснення у неї закупівель товарів, робіт і послуг згідно із Законом України \"Про санкції\", крім випадку, якщо активи такої особи у встановленому законодавством порядку передані в управління Національному агентству України з питань виявлення, розшуку та управління активами, одержаними від корупційних та інших злочинів",
              "title_en": "Neither the economic operator nor its ultimate beneficial owner, member or participant (shareholder) is a person in respect of whom the sanction prohibiting the procurement of goods, works and services from that person has been imposed pursuant to the Law of Ukraine \"On Sanctions\", except where the assets of such person have been transferred for management to the National Agency of Ukraine for Finding, Tracing and Management of Assets Derived from Corruption and Other Crimes in accordance with the procedure established by law",
              "dataType": "boolean",
              "expectedValue": true
            }
          ]
        }
      ]
