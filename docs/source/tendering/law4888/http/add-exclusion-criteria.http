              "id": "0164bb8936434c30b60185078e146a58",
              "datePublished": "2027-01-01T00:00:00+02:00"
            }
          ],
          "id": "f9f2f1db53114469b0d8af750aba0f3e"
        }
      ]
    }
  ]
