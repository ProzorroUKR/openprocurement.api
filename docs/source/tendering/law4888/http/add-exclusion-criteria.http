  "data": [
    {
      "title": "Наявність впливу на прийняття рішення замовника",
      "title_en": "Influence on the procuring entity's decision-making",
      "description": "Замовник має незаперечні докази того, що суб’єкт господарювання надає або погоджується надати прямо чи опосередковано будь-якій службовій (посадовій) особі замовника, іншого державного органу винагороду в будь-якій формі (пропозиція про найм на роботу, цінна річ, послуга або інша винагорода) з метою впливу на прийняття рішення про визначення переможця або розгляд документів, поданих суб’єктом господарювання, або застосування замовником певного способу закупівель, визначеного цим Законом.",
      "description_en": "The procuring entity possesses irrefutable evidence that the economic operator offers or agrees to offer, directly or indirectly, any remuneration in any form (including an offer of employment, a valuable item, a service or any other benefit) to any officer (official) of the procuring entity or of another State authority for the purpose of influencing the decision on the selection of the winner, the examination of the documents submitted by the economic operator, or the application by the procuring entity of a procurement method provided for by this Law.",
      "source": "procuringEntity",
      "classification": {
        "scheme": "LAW4888",
        "id": "CRITERION.EXCLUSION.CONFLICT_OF_INTEREST.MISINTERPRETATION"
      },
      "relatesTo": "tender",
      "legislation": [
        {
          "version": "2026-05-27",
          "identifier": {
            "id": "4888-IX",
            "legalName": "Закон України \"Про публічні закупівлі\"",
            "legalName_en": "Law of Ukraine \"On Public Procurement\"",
            "uri": "https://zakon.rada.gov.ua/laws/show/4888-20#n686"
          },
          "type": "NATIONAL_LEGISLATION",
          "article": "Пункт 1 частини 1 статті 21",
          "article_en": "Clause 1 of part 1 of article 21"
        }
      ],
      "requirementGroups": [
        {
          "description": "Підтверджується, що:",
          "description_en": "It is confirmed that:",
          "requirements": [
            {
              "title": "Суб’єкт господарювання надає або погоджується надати прямо чи опосередковано будь-якій службовій (посадовій) особі замовника, іншого державного органу винагороду в будь-якій формі (пропозиція про найм на роботу, цінна річ, послуга або інша винагорода) з метою впливу на прийняття рішення про визначення переможця або розгляд документів, поданих суб’єктом господарювання, або застосування замовником певного способу закупівель, визначеного цим Законом",
              "title_en": "The economic operator offers or agrees to offer, directly or indirectly, any remuneration in any form (an offer of employment, a valuable item, a service or any other benefit) to any officer (official) of the procuring entity or of another State authority for the purpose of influencing the decision on the selection of the winner, the examination of the documents submitted by the economic operator, or the application by the procuring entity of a procurement method provided for by this Law",
              "dataType": "boolean",
              "eligibleEvidences": [
                {
                  "title": "Документальне підтвердження",
                  "title_en": "",
                  "type": "document",
                  "relatedDocument": {
                    "id": "426c17fd327c44869865efce186d53f4"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Вчинення корупційних правопорушень",
      "title_en": "Commission of corruption offences",
      "description": "Відомості про суб’єкта господарювання внесено до Єдиного державного реєстру осіб, які вчинили корупційні або пов’язані з корупцією правопорушення; керівника суб’єкта господарювання або суб’єкта господарювання було притягнуто до відповідальності згідно із законом за вчинення корупційного правопорушення або правопорушення, пов’язаного з корупцією.",
      "description_en": "Information concerning the economic operator has been entered into the Unified State Register of Persons Who Have Committed Corruption or Corruption-Related Offences; the head of the economic operator or the economic operator has been held liable in accordance with the law for committing a corruption offence or a corruption-related offence.",
      "source": "winner",
      "classification": {
        "scheme": "LAW4888",
        "id": "CRITERION.EXCLUSION.CONVICTIONS.CORRUPTION"
      },
      "relatesTo": "tender",
