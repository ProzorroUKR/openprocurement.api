                  "relatedDocument": {
                    "id": "426c17fd327c44869865efce186d53f4"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Інформування про субпідрядників/співвиконавців",
      "title_en": "Information on subcontractors and co-performers",
      "description": "У разі якщо учасник, кандидат має намір залучити спроможності іншого суб’єкта господарювання як субпідрядника/співвиконавця в обсязі не менше ніж 20 відсотків від ціни публічного договору про виконання робіт або надання послуги (послуг), для підтвердження його відповідності кваліфікаційному критерію відповідно до пунктів 1, 2 частини другої статті 20 цього Закону (у разі застосування таких критеріїв до такого суб’єкта господарювання) учасник, кандидат надає підтвердження відсутності підстав для відмови в участі у закупівлі, визначених частинами першою та другою цієї статті, а також документи, що надаються переможцем відповідно до частини п’ятої цієї статті, щодо кожного залученого субпідрядника / співвиконавця.",
      "description_en": "Where a bidder or candidate intends to rely on the capacities of another economic operator as a subcontractor / co-performer to an extent of not less than twenty (20) per cent of the price of the works contract or service contract for the purpose of demonstrating compliance with the qualification criterion in accordance with Clauses 1 and 2 of Part 2 of Article 20 of this Law (if such criteria apply to that economic operator), the bidder or candidate shall provide confirmation of the absence of the grounds for refusing its participation in procurement specified in Parts 1 and 2 of this Article, as well as the documents to be submitted by the winner in accordance with Part 5 of this Article, in respect of each subcontractor / co-performer engaged.",
      "source": "winner",
      "classification": {
        "scheme": "LAW4888",
        "id": "CRITERION.SELECTION.TECHNICAL_PROFESSIONAL_ABILITY.MANAGEMENT.SUBCONTRACTING_PROPORTION"
      },
      "relatesTo": "lot",
