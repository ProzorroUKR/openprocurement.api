      {
        "requirement": {
          "id": "6287b2f15e274c8ebbc12534a20cfbaa",
          "title": "Керівника суб’єкта господарювання або суб’єкта господарювання не було притягнуто до відповідальності згідно із законом за вчинення корупційного правопорушення або правопорушення, пов’язаного з корупцією"
        },
        "value": true,
        "id": "44394350ef4b40e1936ef67f8811b11d",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.CONVICTIONS.CORRUPTION"
        }
      },
      {
        "requirement": {
          "id": "8c70701e46534907bdbc3a8ce0a7853d",
          "title": "Суб’єкт господарювання (учасник / кандидат) протягом останніх трьох років не притягувався до відповідальності за порушення, у вигляді вчинення антиконкурентних узгоджених дій, що стосуються спотворення результатів тендерів, торгів, аукціонів, конкурсів, відомості щодо якого містяться в Державному реєстрі суб’єктів господарювання, притягнутих до відповідальності за вчинення порушення"
        },
        "value": true,
        "id": "56a20f72a15942ac85391f0f1d15074f",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.CONVICTIONS.FRAUD"
        }
      },
      {
        "requirement": {
          "id": "7f54bbb808df41138b007885d0dca1de",
          "title": "Суб’єкта господарювання не було засуджено за кримінальне правопорушення, вчинене з корисливих мотивів, судимість з якого не знято або не погашено у встановленому законом порядку"
        },
