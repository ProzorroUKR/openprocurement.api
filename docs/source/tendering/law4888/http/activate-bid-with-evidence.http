        "requirement": {
          "id": "0e9e96b6a9a74b03b789cc309eda4281",
          "title": "Суб’єкта господарювання у встановленому законом порядку не визнано банкрутом та стосовно нього не відкрито ліквідаційну процедуру"
        },
        "value": true,
        "id": "0046501a9dbe46e884b317d304ffd2d7",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.BUSINESS.BANKRUPTCY"
        }
      },
      {
        "requirement": {
          "id": "739d8bc0ce7540049d1d23185dd66711",
          "title": "В Єдиному державному реєстрі юридичних осіб, фізичних осіб - підприємців та громадських формувань присутня інформація, передбачена пунктом 9 частини другої статті 9 Закону України \"Про державну реєстрацію юридичних осіб, фізичних осіб - підприємців та громадських формувань\""
        },
        "value": true,
        "id": "70af371e4e254d7e931071c98f647ce0",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.NATIONAL.OTHER"
        }
      },
      {
        "requirement": {
          "id": "4967b7a487ba473abf5a6ceede0e5915",
          "title": "Суб’єкт господарювання має антикорупційну програму чи уповноваженого з реалізації антикорупційної програми"
        },
        "value": true,
        "id": "13b1b919f0a34c3e93b915d7f61fd415",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.NATIONAL.ANTI-CORRUPTION"
        }
      },
      {
        "requirement": {
          "id": "b595d381372d4adcb7fe53af989780ca",
          "title": "Суб’єкт господарювання або кінцевий бенефіціарний власник, член або учасник (акціонер) суб’єкта господарювання не є особою, до якої застосовано санкцію у виді заборони на здійснення у неї закупівель товарів, робіт і послуг згідно із Законом України \"Про санкції\", крім випадку, якщо активи такої особи у встановленому законодавством порядку передані в управління Національному агентству України з питань виявлення, розшуку та управління активами, одержаними від корупційних та інших злочинів"
        },
        "value": true,
        "id": "7e3c16fd30584baaa32b1bbd930c2bb9",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.CONVICTIONS.TERRORIST_OFFENCES"
        }
      },
      {
        "requirement": {
          "id": "6c16f39455ad41e6824122b7e160fee7",
          "title": "Керівника суб’єкта господарювання не було притягнуто згідно із законом до відповідальності за вчинення правопорушення, пов’язаного з використанням дитячої праці чи будь-якими формами торгівлі людьми, фінансування тероризму, вчинення терористичного акту"
        },
        "value": true,
        "id": "4e72267e23a14442aaa56fdc9f69b174",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.CONVICTIONS.CHILD_LABOUR-HUMAN_TRAFFICKING"
        }
      },
      {
        "requirement": {
          "id": "2b03eb48dc7943d1bfd17e5d8e9e6a41",
          "title": "Суб’єкт господарювання не має заборгованості зі сплати податків і зборів (обов'язкових платежів)"
        },
        "value": true,
        "id": "49d9286b9dd644deb6ca2afa91239c08",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.CONTRIBUTIONS.PAYMENT_OF_TAXES"
        }
      },
      {
        "requirement": {
          "id": "0655f853ea4c4403b1da56806bb42001",
          "title": "Cуб’єкт господарювання не отримував від замовника під час проведення попередніх ринкових консультацій інформацію, що може надати йому конкурентну перевагу перед іншими учасниками, кандидатами, або попереднє залучення суб’єкта господарювання до підготовки процедури закупівлі призвело до порушення принципу недискримінації та рівного ставлення до суб’єктів господарювання"
        },
        "value": true,
        "id": "ae842358d696445c923b7582f437fdd0",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.CONFLICT_OF_INTEREST.PROCEDURE_PREPARATION"
        }
      },
      {
        "requirement": {
          "id": "01a3b91533874e6b895ce73aee037eec",
          "title": "Відсутній конфлікт інтересів у розумінні частини п’ятої статті 14 цього Закону який неможливо врегулювати"
        },
        "value": true,
        "id": "b5c24b4393214ac989d27c14fdf68d79",
        "classification": {
          "scheme": "LAW4888",
          "id": "CRITERION.EXCLUSION.CONFLICT_OF_INTEREST.PROCEDURE_PARTICIPATION"
        }
      },
      {
        "requirement": {
          "id": "ff693291fa094d2698eb350cd3983531",
          "title": "Суб’єкт господарювання не мав з цим самим замовником публічного договору, який було достроково розірвано через невиконання суб’єктом господарювання своїх зобов’язань із застосуванням санкції у виді неустойки та/або відшкодування збитків протягом трьох років з дати дострокового розірвання такого договору"
        },
