{
  "data": [
    {
      "title": "Витрати, пов’язані з користуванням, грн.",
      "description": "Для розрахунку витрат, пов’язаних з користуванням, замовник визначає в тендерній документації одиницю виміру життєвого циклу та зазначає вартість споживання електроенергії та інших ресурсів (наприклад, поточні ціни на бензин або дані від Національної комісії, що здійснює державне регулювання у сферах енергетики та комунальних послуг, щодо вартості електроенергії тощо)",
      "source": "tenderer",
      "classification": {
        "scheme": "LCC",
        "id": "CRITERION.OTHER.LIFE_CYCLE_COST.COST_OF_USE"
      },
      "relatesTo": "tender",
      "legislation": [
        {
          "version": "2020-09-28",
          "identifier": {
            "id": "1894",
            "legalName": "Наказ Мінекономіки \"Про затвердження Примірної методики визначення вартості життєвого циклу\"",
            "uri": "https://me.gov.ua/legislativeacts/Detail?lang=uk-UA&id=32140d03-d5eb-4988-8790-6d60d1c84a93"
          },
          "type": "NATIONAL_LEGISLATION",
          "article": "2.6"
        }
      ],
      "requirementGroups": [
        {
          "description": "Підтверджується, що",
          "requirements": [
            {
              "title": "Витрати в частині споживання ресурсу під час користування протягом визначеного замовником періоду оцінки життєвого циклу",
              "dataType": "number",
              "minValue": 0.0,
              "unit": {
                "code": "E50",
                "name": "одиниця"
              }
            }
          ]
        }
      ]
    },
    {
      "title": "Витрати, пов’язані з обслуговуванням, грн.",
      "description": "Для розрахунку витрат, пов’язаних з обслуговуванням, замовник у тендерній документації серед переліку інформації, що надає учасник, може запитати інформацію щодо вартості обслуговування, ремонту та/або заміни складових предмета закупівлі за одиницю виміру життєвого циклу, а також документи від виробника про характеристики предмета закупівлі",
      "source": "tenderer",
      "classification": {
        "scheme": "LCC",
        "id": "CRITERION.OTHER.LIFE_CYCLE_COST.MAINTENANCE_COST"
      },
      "relatesTo": "tender",
      "legislation": [
        {
          "version": "2020-09-28",
          "identifier": {
            "id": "1894",
            "legalName": "Наказ Мінекономіки \"Про затвердження Примірної методики визначення вартості життєвого циклу\"",
            "uri": "https://me.gov.ua/legislativeacts/Detail?lang=uk-UA&id=32140d03-d5eb-4988-8790-6d60d1c84a93"
          },
          "type": "NATIONAL_LEGISLATION",
          "article": "2.7"
        }
      ],
      "requirementGroups": [
        {
          "description": "Підтверджується, що",
          "requirements": [
            {
              "title": "Витрати пов’язані з обслуговуванням протягом визначеного замовником періоду оцінки життєвого циклу",
              "dataType": "number",
              "minValue": 0.0,
              "unit": {
                "code": "E50",
                "name": "одиниця"
              }
            }
          ]
        }
      ]
    },
    {
      "title": "Витрати, пов’язані з завершенням користування, грн.",
      "description": "Для розрахунку витрат, пов’язаних з завершенням користування, замовник у тендерній документації серед переліку інформації, що надає учасник процедури закупівлі, може запитати інформацію щодо вартості демонтажу, утилізації, переробки та інших витрат",
      "source": "tenderer",
      "classification": {
        "scheme": "LCC",
        "id": "CRITERION.OTHER.LIFE_CYCLE_COST.END_OF_LIFE_COST"
      },
      "relatesTo": "tender",
      "legislation": [
        {
          "version": "2020-09-28",
          "identifier": {
            "id": "1894",
            "legalName": "Наказ Мінекономіки \"Про затвердження Примірної методики визначення вартості життєвого циклу\"",
            "uri": "https://me.gov.ua/legislativeacts/Detail?lang=uk-UA&id=32140d03-d5eb-4988-8790-6d60d1c84a93"
          },
          "type": "NATIONAL_LEGISLATION",
          "article": "2.8"
        }
      ],
      "requirementGroups": [
        {
          "description": "Підтверджується, щ",
          "requirements": [
            {
              "title": "Витрати пов’язані з завершенням користування",
              "dataType": "number",
              "minValue": 0.0,
              "unit": {
                "code": "E50",
                "name": "одиниця"
              }
            }
          ]
        }
      ]
    },
    {
      "title": "Витрати, пов’язані з захистом навколишнього середовища, грн.",
      "description": "Замовник додатково для розрахунку вартості життєвого циклу може використовувати параметри витрат, пов’язаних із захистом навколишнього природного середовища (вартість екологічних витрат)",
      "source": "tenderer",
      "classification": {
        "scheme": "LCC",
        "id": "CRITERION.OTHER.LIFE_CYCLE_COST.ECOLOGICAL_COST"
      },
      "relatesTo": "tender",
      "legislation": [
        {
          "version": "2020-09-28",
          "identifier": {
            "id": "1894",
            "legalName": "Наказ Мінекономіки \"Про затвердження Примірної методики визначення вартості життєвого циклу\"",
            "uri": "https://me.gov.ua/legislativeacts/Detail?lang=uk-UA&id=32140d03-d5eb-4988-8790-6d60d1c84a93"
          },
          "type": "NATIONAL_LEGISLATION",
          "article": "2.9"
        }
      ],
      "requirementGroups": [
        {
          "description": "Підтверджується, що",
          "requirements": [
            {
              "title": "Витрати, пов’язані з захистом навколишнього середовища протягом визначеного замовником періоду оцінки життєвого циклу",
              "dataType": "number",
              "minValue": 0.0,
              "unit": {
                "code": "E50",
                "name": "одиниця"
              }
            }
          ]
        }
      ]
    }
