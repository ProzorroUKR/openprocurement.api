                "ME",
                "HK",
                "IS",
                "JP",
                "KR",
                "LI",
                "AW",
                "NZ",
                "MK",
                "NO",
                "SG",
                "CH",
                "TW",
                "GB",
                "US"
              ]
            }
          ]
        }
      ],
      "relatedItem": "2e91e3e715a941bd8cba92984bf8cd4f"
    }
  ]
}


